# =====================================================================
# CRISP AI 3.0 Enterprise Configuration Template
# Copy to .env and adjust credentials for deployment.
# =====================================================================

# App Environment: development | testing | production
ENVIRONMENT=development
DEBUG=False

# Database Connection (PostgreSQL for Production, SQLite for local dev)
# Local SQLite example:
DATABASE_URL=sqlite:///./crisp_ai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://crisp_user:ChangeMeSecurePassword123@localhost:5432/crisp_ai_db

# Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True
DB_POOL_RECYCLE_SECONDS=3600

# Authentication & Security
# Generate secure 64-char secret: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration: local | s3
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=50

# S3-Compatible Object Storage (e.g. AWS S3, MinIO, Cloudflare R2)
# S3_BUCKET=crisp-ai-datasets
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# AWS_REGION=us-east-1

# Distributed Job Queue (Redis)
# REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
